{
  "actions": [],
  "autoname": "format:PAGE-{####}",
  "creation": "2026-01-01 00:00:00.000000",
  "doctype": "DocType",
  "engine": "InnoDB",
  "field_order": [
    "title",
    "slug",
    "template",
    "workflow_state",
    "cb1",
    "source_file",
    "extracted_text",
    "sb_content",
    "content_json",
    "sb_seo",
    "meta_title",
    "meta_description",
    "og_title",
    "og_description",
    "og_image",
    "canonical_url",
    "sb_pub",
    "published_at",
    "published_by",
    "sb_ai",
    "ai_job",
    "generation_status",
    "ai_error_log"
  ],
  "fields": [
    {
      "fieldname": "title",
      "fieldtype": "Data",
      "label": "Title",
      "reqd": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "slug",
      "fieldtype": "Data",
      "label": "Slug",
      "reqd": 1,
      "unique": 1,
      "in_list_view": 1,
      "description": "URL-friendly identifier, e.g. my-landing-page"
    },
    {
      "fieldname": "template",
      "fieldtype": "Link",
      "label": "Template",
      "options": "CMS Template",
      "reqd": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "workflow_state",
      "fieldtype": "Select",
      "label": "Workflow State",
      "options": "Draft\nReview\nApproved\nPublished\nArchived",
      "default": "Draft",
      "in_list_view": 1
    },
    {"fieldname": "cb1", "fieldtype": "Column Break"},
    {
      "fieldname": "source_file",
      "fieldtype": "Attach",
      "label": "Source Document",
      "description": "Upload PDF, DOCX, or TXT to trigger AI generation"
    },
    {
      "fieldname": "extracted_text",
      "fieldtype": "Long Text",
      "label": "Extracted Text",
      "read_only": 1,
      "collapsible": 1
    },
    {"fieldname": "sb_content", "fieldtype": "Section Break", "label": "Content"},
    {
      "fieldname": "content_json",
      "fieldtype": "Long Text",
      "label": "Content (JSON)",
      "description": "Canonical JSON following the template schema: {hero, sections, seo, faq, cta}"
    },
    {"fieldname": "sb_seo", "fieldtype": "Section Break", "label": "SEO"},
    {"fieldname": "meta_title", "fieldtype": "Data", "label": "Meta Title"},
    {"fieldname": "meta_description", "fieldtype": "Small Text", "label": "Meta Description"},
    {"fieldname": "og_title", "fieldtype": "Data", "label": "OG Title"},
    {"fieldname": "og_description", "fieldtype": "Small Text", "label": "OG Description"},
    {"fieldname": "og_image", "fieldtype": "Attach Image", "label": "OG Image"},
    {"fieldname": "canonical_url", "fieldtype": "Data", "label": "Canonical URL"},
    {"fieldname": "sb_pub", "fieldtype": "Section Break", "label": "Publishing"},
    {"fieldname": "published_at", "fieldtype": "Datetime", "label": "Published At", "read_only": 1},
    {"fieldname": "published_by", "fieldtype": "Link", "label": "Published By", "options": "User", "read_only": 1},
    {"fieldname": "sb_ai", "fieldtype": "Section Break", "label": "AI Generation", "collapsible": 1},
    {"fieldname": "ai_job", "fieldtype": "Link", "label": "AI Job", "options": "AI Job Log", "read_only": 1},
    {
      "fieldname": "generation_status",
      "fieldtype": "Select",
      "label": "Generation Status",
      "options": "Pending\nQueued\nExtracting\nGenerating\nCompleted\nFailed",
      "default": "Pending",
      "read_only": 1
    },
    {
      "fieldname": "ai_error_log",
      "fieldtype": "Code",
      "label": "AI Error Log",
      "read_only": 1,
      "depends_on": "eval:doc.generation_status=='Failed'"
    }
  ],
  "links": [],
  "modified": "2026-01-01 00:00:00.000000",
  "modified_by": "Administrator",
  "module": "PDCMS",
  "name": "CMS Page",
  "naming_rule": "Expression",
  "owner": "Administrator",
  "permissions": [
    {"create": 1, "delete": 1, "read": 1, "write": 1, "report": 1, "role": "CMS Admin"},
    {"create": 1, "read": 1, "write": 1, "role": "Content Editor"},
    {"read": 1, "write": 1, "role": "CMS Reviewer"},
    {"read": 1, "write": 1, "role": "CMS Publisher"},
    {"read": 1, "role": "Guest", "permlevel": 1}
  ],
  "sort_field": "modified",
  "sort_order": "DESC",
  "states": [
    {"color": "Yellow", "title": "Draft"},
    {"color": "Orange", "title": "Review"},
    {"color": "Blue", "title": "Approved"},
    {"color": "Green", "title": "Published"},
    {"color": "Gray", "title": "Archived"}
  ]
}
