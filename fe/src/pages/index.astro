---
import BaseLayout from "../layouts/BaseLayout.astro";
import Hero from "../components/Hero.astro";
import Stats from "../components/Stats.astro";
import Philosophy from "../components/Philosophy.astro";
import Destinations from "../components/Destinations.astro";
import Process from "../components/Process.astro";
import Testimonials from "../components/Testimonials.astro";
import CtaSection from "../components/CtaSection.astro";

// --- Data source ---
// Option A: local JSON (development / static)
import data from "../data/homepage.json";

// Option B: fetch from Frappe CMS API (uncomment for production)
// const res = await fetch(`${import.meta.env.FRAPPE_URL}/api/resource/CMS Page/homepage`);
// const { data: raw } = await res.json();
// const data = JSON.parse(raw.content_json);
---

<BaseLayout
  title={data.seo.meta_title}
  description={data.seo.meta_description}
  ogImage={data.seo.og_image}
>
  <Hero {...data.hero} />
  <Stats items={data.stats} />
  <Philosophy
    eyebrow={data.philosophy.eyebrow}
    left_card={data.philosophy.left_card}
    right_card={data.philosophy.right_card}
  />
  <Destinations
    eyebrow={data.destinations.eyebrow}
    heading={data.destinations.heading}
    subheading={data.destinations.subheading}
    tabs={data.destinations.tabs}
    active_tab={data.destinations.active_tab}
    routes={data.destinations.routes}
  />
  <Process
    eyebrow={data.process.eyebrow}
    heading={data.process.heading}
    subheading={data.process.subheading}
    steps={data.process.steps}
    cta_text={data.process.cta_text}
    cta_url={data.process.cta_url}
  />
  <Testimonials
    eyebrow={data.testimonials.eyebrow}
    heading={data.testimonials.heading}
    subheading={data.testimonials.subheading}
    items={data.testimonials.items}
  />
  <CtaSection
    eyebrow={data.cta_section.eyebrow}
    heading={data.cta_section.heading}
    body={data.cta_section.body}
    cta_primary_text={data.cta_section.cta_primary_text}
    cta_primary_url={data.cta_section.cta_primary_url}
    cta_secondary_text={data.cta_section.cta_secondary_text}
    cta_secondary_url={data.cta_section.cta_secondary_url}
    why_paideia_label={data.cta_section.why_paideia_label}
    why_paideia_points={data.cta_section.why_paideia_points}
    next_steps_label={data.cta_section.next_steps_label}
    next_steps_points={data.cta_section.next_steps_points}
    cards={data.cta_section.cards}
  />
</BaseLayout>
