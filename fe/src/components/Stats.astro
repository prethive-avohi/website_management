---
interface StatItem {
  value: string;
  label: string;
}
interface Props {
  items: StatItem[];
}
const { items } = Astro.props;
---

<section class="stats">
  <div class="stats__inner">
    {items.map((s) => (
      <div class="stats__item">
        <span class="stats__value">{s.value}</span>
        <span class="stats__label">{s.label}</span>
      </div>
    ))}
  </div>
</section>

<style>
.stats {
  background: var(--white);
  border-bottom: 1px solid var(--grey-100);
  padding: 28px 24px;
}
.stats__inner {
  max-width: 900px;
  margin: 0 auto;
  display: flex;
  justify-content: space-around;
  flex-wrap: wrap;
  gap: 20px;
}
.stats__item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4px;
}
.stats__value {
  font-size: 1.6rem;
  font-weight: 800;
  color: var(--navy);
}
.stats__label {
  font-size: 0.75rem;
  font-weight: 500;
  color: var(--grey-600);
  text-align: center;
  text-transform: uppercase;
  letter-spacing: 0.08em;
}
</style>
