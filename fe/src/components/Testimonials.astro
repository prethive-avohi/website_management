---
interface TestimonialItem {
  stars: number;
  quote: string;
  author: string;
  role: string;
}
interface Props {
  eyebrow: string;
  heading: string;
  subheading: string;
  items: TestimonialItem[];
}
const p = Astro.props;
---

<section class="testi">
  <div class="testi__inner">
    <div class="testi__meta">
      <p class="testi__eyebrow">{p.eyebrow}</p>
      <h2 class="testi__heading">{p.heading}</h2>
      <p class="testi__sub">{p.subheading}</p>
    </div>
    <div class="testi__cards">
      {p.items.map((t) => (
        <div class="testi__card">
          <div class="testi__stars" aria-label={`${t.stars} stars`}>
            {Array.from({ length: t.stars }).map(() => (
              <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
            ))}
          </div>
          <blockquote class="testi__quote">"{t.quote}"</blockquote>
          <div class="testi__author">
            <p class="testi__author-name">{t.author}</p>
            <p class="testi__author-role">{t.role}</p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
.testi {
  background: var(--grey-50);
  padding: 80px 24px;
}
.testi__inner {
  max-width: 1100px;
  margin: 0 auto;
  display: grid;
  grid-template-columns: 1fr 2fr;
  gap: 60px;
  align-items: start;
}
.testi__eyebrow {
  font-size: 0.72rem;
  font-weight: 700;
  letter-spacing: 0.14em;
  text-transform: uppercase;
  color: var(--gold);
  margin-bottom: 12px;
}
.testi__heading {
  font-size: clamp(1.6rem, 3vw, 2rem);
  font-weight: 800;
  color: var(--navy);
  line-height: 1.2;
  margin-bottom: 12px;
}
.testi__sub {
  font-size: 0.85rem;
  color: var(--grey-600);
  line-height: 1.7;
}
.testi__cards {
  display: flex;
  flex-direction: column;
  gap: 20px;
}
.testi__card {
  background: var(--white);
  border: 1px solid var(--grey-100);
  border-radius: 12px;
  padding: 28px;
  display: flex;
  flex-direction: column;
  gap: 12px;
  box-shadow: 0 2px 8px rgba(0,0,0,0.04);
}
.testi__stars {
  display: flex;
  gap: 3px;
  color: var(--gold);
}
.testi__quote {
  font-size: 0.95rem;
  color: var(--grey-800);
  line-height: 1.7;
  font-style: normal;
}
.testi__author-name {
  font-size: 0.88rem;
  font-weight: 700;
  color: var(--navy);
}
.testi__author-role {
  font-size: 0.78rem;
  color: var(--grey-600);
}

@media (max-width: 768px) {
  .testi__inner { grid-template-columns: 1fr; gap: 32px; }
}
</style>
