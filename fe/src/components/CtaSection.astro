---
interface Props {
  eyebrow: string;
  heading: string;
  body: string;
  cta_primary_text: string;
  cta_primary_url: string;
  cta_secondary_text: string;
  cta_secondary_url: string;
  why_paideia_label: string;
  why_paideia_points: string[];
  next_steps_label: string;
  next_steps_points: string[];
  cards: { label: string }[];
}
const p = Astro.props;
---

<section class="cta-section">
  <div class="cta-section__inner">
    <div class="cta-section__top">
      <div class="cta-section__left">
        <p class="cta-section__eyebrow">{p.eyebrow}</p>
        <h2 class="cta-section__heading">{p.heading}</h2>
        <p class="cta-section__body">{p.body}</p>
        <div class="cta-section__btns">
          <a class="cta-section__btn-primary" href={p.cta_primary_url}>{p.cta_primary_text}</a>
          <a class="cta-section__btn-secondary" href={p.cta_secondary_url}>{p.cta_secondary_text}</a>
        </div>
      </div>
      <div class="cta-section__right">
        <div class="cta-section__col">
          <p class="cta-section__col-label">{p.why_paideia_label}</p>
          <ul class="cta-section__list">
            {p.why_paideia_points.map((pt) => (
              <li>
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
                {pt}
              </li>
            ))}
          </ul>
        </div>
        <div class="cta-section__col">
          <p class="cta-section__col-label">{p.next_steps_label}</p>
          <ul class="cta-section__list">
            {p.next_steps_points.map((pt) => (
              <li>
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
                {pt}
              </li>
            ))}
          </ul>
        </div>
      </div>
    </div>
    <div class="cta-section__cards">
      {p.cards.map((c) => (
        <div class="cta-section__card">
          <p>{c.label}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
.cta-section {
  background: var(--navy);
  padding: 80px 24px;
  color: var(--white);
}
.cta-section__inner { max-width: 1100px; margin: 0 auto; }
.cta-section__top {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 60px;
  margin-bottom: 48px;
}
.cta-section__eyebrow {
  font-size: 0.7rem;
  font-weight: 700;
  letter-spacing: 0.14em;
  text-transform: uppercase;
  color: var(--gold);
  margin-bottom: 14px;
}
.cta-section__heading {
  font-size: clamp(1.7rem, 3.5vw, 2.4rem);
  font-weight: 800;
  line-height: 1.15;
  margin-bottom: 16px;
}
.cta-section__body {
  font-size: 0.9rem;
  color: rgba(255,255,255,0.7);
  line-height: 1.7;
  margin-bottom: 28px;
}
.cta-section__btns { display: flex; flex-wrap: wrap; gap: 12px; }
.cta-section__btn-primary {
  background: var(--gold);
  color: var(--navy);
  border-radius: 8px;
  padding: 12px 28px;
  font-size: 0.88rem;
  font-weight: 700;
  transition: background 0.2s;
}
.cta-section__btn-primary:hover { background: var(--gold-light); }
.cta-section__btn-secondary {
  background: transparent;
  border: 1px solid rgba(255,255,255,0.3);
  color: var(--white);
  border-radius: 8px;
  padding: 12px 28px;
  font-size: 0.88rem;
  font-weight: 600;
  transition: border-color 0.2s;
}
.cta-section__btn-secondary:hover { border-color: var(--gold); color: var(--gold); }
.cta-section__right {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 32px;
}
.cta-section__col-label {
  font-size: 0.68rem;
  font-weight: 700;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  color: var(--gold);
  margin-bottom: 14px;
}
.cta-section__list {
  list-style: none;
  display: flex;
  flex-direction: column;
  gap: 10px;
}
.cta-section__list li {
  display: flex;
  align-items: flex-start;
  gap: 8px;
  font-size: 0.83rem;
  color: rgba(255,255,255,0.75);
  line-height: 1.5;
}
.cta-section__list svg { flex-shrink: 0; margin-top: 2px; color: var(--gold); }
.cta-section__cards {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
  gap: 16px;
  border-top: 1px solid rgba(255,255,255,0.1);
  padding-top: 32px;
}
.cta-section__card {
  background: rgba(255,255,255,0.06);
  border: 1px solid rgba(255,255,255,0.1);
  border-radius: 10px;
  padding: 20px;
}
.cta-section__card p {
  font-size: 0.85rem;
  color: rgba(255,255,255,0.75);
  line-height: 1.6;
}

@media (max-width: 768px) {
  .cta-section__top { grid-template-columns: 1fr; gap: 32px; }
  .cta-section__right { grid-template-columns: 1fr; gap: 24px; }
}
</style>
