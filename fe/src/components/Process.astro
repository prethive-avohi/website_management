---
interface Step {
  number: string;
  title: string;
  description: string;
}
interface Props {
  eyebrow: string;
  heading: string;
  subheading: string;
  steps: Step[];
  cta_text: string;
  cta_url: string;
}
const p = Astro.props;
---

<section class="process">
  <div class="process__inner">
    <p class="process__eyebrow">{p.eyebrow}</p>
    <h2 class="process__heading">{p.heading}</h2>
    <p class="process__sub">{p.subheading}</p>

    <div class="process__steps">
      {p.steps.map((s, i) => (
        <div class="process__step">
          <div class="process__step-num">{s.number}</div>
          <h3 class="process__step-title">{s.title}</h3>
          <p class="process__step-desc">{s.description}</p>
          {i < p.steps.length - 1 && <div class="process__connector" aria-hidden="true" />}
        </div>
      ))}
    </div>

    <div class="process__cta-wrap">
      <a class="process__cta" href={p.cta_url}>{p.cta_text}</a>
    </div>
  </div>
</section>

<style>
.process {
  background: var(--white);
  padding: 80px 24px;
  text-align: center;
}
.process__inner { max-width: 900px; margin: 0 auto; }
.process__eyebrow {
  font-size: 0.72rem;
  font-weight: 700;
  letter-spacing: 0.14em;
  text-transform: uppercase;
  color: var(--gold);
  margin-bottom: 14px;
}
.process__heading {
  font-size: clamp(1.7rem, 4vw, 2.6rem);
  font-weight: 800;
  color: var(--navy);
  line-height: 1.15;
  margin-bottom: 16px;
}
.process__sub {
  font-size: 0.9rem;
  color: var(--grey-600);
  line-height: 1.7;
  max-width: 560px;
  margin: 0 auto 56px;
}
.process__steps {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 0;
  position: relative;
  margin-bottom: 48px;
}
.process__step {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 0 24px;
  position: relative;
}
.process__step-num {
  width: 52px;
  height: 52px;
  border-radius: 50%;
  background: var(--gold);
  color: var(--navy);
  font-size: 1rem;
  font-weight: 800;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 20px;
  position: relative;
  z-index: 1;
}
.process__connector {
  position: absolute;
  top: 26px;
  right: -50%;
  width: 100%;
  height: 2px;
  background: var(--grey-300);
  z-index: 0;
}
.process__step-title {
  font-size: 1rem;
  font-weight: 700;
  color: var(--navy);
  margin-bottom: 10px;
}
.process__step-desc {
  font-size: 0.85rem;
  color: var(--grey-600);
  line-height: 1.65;
}
.process__cta-wrap { display: flex; justify-content: center; }
.process__cta {
  background: var(--navy);
  color: var(--white);
  border-radius: 8px;
  padding: 14px 32px;
  font-size: 0.92rem;
  font-weight: 700;
  transition: background 0.2s;
}
.process__cta:hover { background: var(--navy-mid); }

@media (max-width: 640px) {
  .process__steps { grid-template-columns: 1fr; gap: 32px; }
  .process__connector { display: none; }
}
</style>
