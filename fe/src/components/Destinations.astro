---
interface Route {
  id: string;
  badge: string;
  heading?: string;
  title: string;
  description: string;
  highlights?: string[];
  lifestyle_label?: string;
  lifestyle_items?: string[];
  career_label?: string;
  career_items?: string[];
  value_label?: string;
  value_items?: string[];
  tags?: string[];
  pros?: string[];
  cta_text: string;
  cta_url: string;
}
interface Props {
  eyebrow: string;
  heading: string;
  subheading: string;
  tabs: string[];
  active_tab: string;
  routes: Route[];
}
const { eyebrow, heading, subheading, tabs, routes } = Astro.props;
---

<section class="dest">
  <div class="dest__inner">
    <p class="dest__eyebrow">{eyebrow}</p>
    <h2 class="dest__heading">{heading}</h2>
    <p class="dest__sub">{subheading}</p>

    <div class="dest__tabs" role="tablist">
      {tabs.map((t) => (
        <button class="dest__tab" data-tab={t.toLowerCase()} role="tab">{t}</button>
      ))}
    </div>

    <div class="dest__grid">
      {routes.map((r) => (
        <div class="dest__card" data-route={r.id}>
          <div class="dest__card-header">
            <span class="dest__badge">{r.badge}</span>
            {r.heading && <p class="dest__card-eyebrow">{r.heading}</p>}
          </div>
          <h3 class="dest__card-title">{r.title}</h3>
          <p class="dest__card-desc">{r.description}</p>

          {r.tags && (
            <div class="dest__tags">
              {r.tags.map((tag) => <span class="dest__tag">{tag}</span>)}
            </div>
          )}

          {r.pros && (
            <ul class="dest__pros">
              {r.pros.map((pro) => (
                <li class="dest__pro">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
                  {pro}
                </li>
              ))}
            </ul>
          )}

          {r.lifestyle_label && (
            <div class="dest__section">
              <p class="dest__section-label">{r.lifestyle_label}</p>
              <ul class="dest__list">
                {r.lifestyle_items?.map((i) => <li>{i}</li>)}
              </ul>
            </div>
          )}

          {r.career_label && (
            <div class="dest__section">
              <p class="dest__section-label">{r.career_label}</p>
              <ul class="dest__list">
                {r.career_items?.map((i) => <li>{i}</li>)}
              </ul>
            </div>
          )}

          {r.value_label && (
            <div class="dest__section">
              <p class="dest__section-label">{r.value_label}</p>
              <ul class="dest__list">
                {r.value_items?.map((i) => <li>{i}</li>)}
              </ul>
            </div>
          )}

          <a class="dest__cta" href={r.cta_url}>{r.cta_text}</a>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
.dest {
  background: var(--navy);
  padding: 80px 24px;
  color: var(--white);
}
.dest__inner {
  max-width: 1100px;
  margin: 0 auto;
}
.dest__eyebrow {
  font-size: 0.72rem;
  font-weight: 700;
  letter-spacing: 0.14em;
  text-transform: uppercase;
  color: var(--gold);
  margin-bottom: 14px;
}
.dest__heading {
  font-size: clamp(1.8rem, 4vw, 2.8rem);
  font-weight: 800;
  color: var(--white);
  line-height: 1.15;
  margin-bottom: 16px;
  max-width: 640px;
}
.dest__sub {
  font-size: 0.9rem;
  color: rgba(255,255,255,0.65);
  line-height: 1.7;
  max-width: 600px;
  margin-bottom: 36px;
}
.dest__tabs {
  display: flex;
  gap: 8px;
  margin-bottom: 40px;
}
.dest__tab {
  background: transparent;
  border: 1px solid rgba(255,255,255,0.2);
  color: rgba(255,255,255,0.7);
  border-radius: 6px;
  padding: 8px 20px;
  font-size: 0.85rem;
  font-weight: 600;
  cursor: pointer;
  transition: all 0.2s;
  font-family: var(--font);
}
.dest__tab:hover,
.dest__tab.active {
  background: var(--gold);
  border-color: var(--gold);
  color: var(--navy);
}
.dest__grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
  gap: 24px;
}
.dest__card {
  background: rgba(255,255,255,0.06);
  border: 1px solid rgba(255,255,255,0.1);
  border-radius: 12px;
  padding: 28px;
  display: flex;
  flex-direction: column;
  gap: 14px;
}
.dest__card-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 8px;
}
.dest__badge {
  font-size: 0.65rem;
  font-weight: 700;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  background: var(--gold);
  color: var(--navy);
  padding: 3px 8px;
  border-radius: 4px;
}
.dest__card-eyebrow {
  font-size: 0.7rem;
  font-weight: 600;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  color: rgba(255,255,255,0.5);
}
.dest__card-title {
  font-size: 1.3rem;
  font-weight: 800;
  color: var(--white);
  line-height: 1.25;
}
.dest__card-desc {
  font-size: 0.85rem;
  color: rgba(255,255,255,0.65);
  line-height: 1.7;
}
.dest__tags {
  display: flex;
  flex-wrap: wrap;
  gap: 6px;
}
.dest__tag {
  font-size: 0.68rem;
  font-weight: 600;
  text-transform: uppercase;
  letter-spacing: 0.08em;
  border: 1px solid rgba(255,255,255,0.2);
  border-radius: 4px;
  padding: 3px 8px;
  color: rgba(255,255,255,0.7);
}
.dest__pros {
  list-style: none;
  display: flex;
  flex-direction: column;
  gap: 8px;
}
.dest__pro {
  display: flex;
  align-items: flex-start;
  gap: 8px;
  font-size: 0.85rem;
  color: rgba(255,255,255,0.8);
  line-height: 1.5;
}
.dest__pro svg { flex-shrink: 0; margin-top: 2px; color: var(--gold); }
.dest__section { display: flex; flex-direction: column; gap: 6px; }
.dest__section-label {
  font-size: 0.68rem;
  font-weight: 700;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  color: var(--gold);
}
.dest__list {
  list-style: none;
  display: flex;
  flex-direction: column;
  gap: 4px;
}
.dest__list li {
  font-size: 0.82rem;
  color: rgba(255,255,255,0.7);
  padding-left: 12px;
  position: relative;
}
.dest__list li::before {
  content: '–';
  position: absolute;
  left: 0;
  color: var(--gold);
}
.dest__cta {
  margin-top: auto;
  display: inline-block;
  background: var(--gold);
  color: var(--navy);
  border-radius: 6px;
  padding: 10px 20px;
  font-size: 0.85rem;
  font-weight: 700;
  text-align: center;
  transition: background 0.2s;
}
.dest__cta:hover { background: var(--gold-light); }
</style>

<script>
const tabs = document.querySelectorAll<HTMLButtonElement>('.dest__tab');
tabs.forEach((tab) => {
  tab.addEventListener('click', () => {
    tabs.forEach((t) => t.classList.remove('active'));
    tab.classList.add('active');
  });
});
if (tabs.length) tabs[0].classList.add('active');
</script>
