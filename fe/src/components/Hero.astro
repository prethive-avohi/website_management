---
interface Props {
  eyebrow: string;
  headline: string;
  subheadline: string;
  search_placeholder: string;
  select_placeholder: string;
  cta_text: string;
  cta_url: string;
  background_image: string;
}
const p = Astro.props;
---

<section class="hero" style={`background-image: url(${p.background_image})`}>
  <div class="hero__overlay"></div>
  <div class="hero__inner">
    <p class="hero__eyebrow">{p.eyebrow}</p>
    <h1 class="hero__headline" set:html={p.headline.replace("Beyond", "<span class='gold'>Beyond</span>")} />
    <p class="hero__sub">{p.subheadline}</p>
    <form class="hero__search" action={p.cta_url}>
      <div class="hero__search-icon">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/></svg>
      </div>
      <input class="hero__input" type="text" placeholder={p.search_placeholder} name="q" />
      <select class="hero__select" name="type">
        <option value="">{p.select_placeholder}</option>
        <option value="undergraduate">Undergraduate</option>
        <option value="postgraduate">Postgraduate</option>
        <option value="professional">Professional</option>
      </select>
      <button class="hero__btn" type="submit">{p.cta_text}</button>
    </form>
  </div>
</section>

<style>
.hero {
  position: relative;
  min-height: 560px;
  background-size: cover;
  background-position: center;
  display: flex;
  align-items: center;
  justify-content: center;
  text-align: center;
  padding: 80px 24px 60px;
}
.hero__overlay {
  position: absolute;
  inset: 0;
  background: linear-gradient(to bottom, rgba(10,22,40,0.72) 0%, rgba(10,22,40,0.55) 100%);
}
.hero__inner {
  position: relative;
  z-index: 1;
  max-width: 760px;
  width: 100%;
}
.hero__eyebrow {
  font-size: 11px;
  font-weight: 600;
  letter-spacing: 0.14em;
  color: var(--grey-300);
  text-transform: uppercase;
  margin-bottom: 20px;
}
.hero__headline {
  font-size: clamp(2.4rem, 6vw, 4rem);
  font-weight: 900;
  color: var(--white);
  line-height: 1.1;
  margin-bottom: 16px;
}
:global(.gold) { color: var(--gold); }
.hero__sub {
  font-size: 1rem;
  color: rgba(255,255,255,0.8);
  margin-bottom: 36px;
}
.hero__search {
  display: flex;
  align-items: center;
  background: var(--white);
  border-radius: 8px;
  overflow: hidden;
  padding: 6px 6px 6px 16px;
  gap: 8px;
  box-shadow: 0 8px 32px rgba(0,0,0,0.18);
}
.hero__search-icon { color: var(--grey-600); display: flex; align-items: center; }
.hero__input {
  flex: 1;
  border: none;
  outline: none;
  font-size: 0.9rem;
  font-family: var(--font);
  color: var(--grey-800);
  min-width: 0;
}
.hero__select {
  border: none;
  outline: none;
  font-size: 0.85rem;
  font-family: var(--font);
  color: var(--grey-600);
  background: transparent;
  cursor: pointer;
  padding: 4px 8px;
  border-left: 1px solid var(--grey-300);
}
.hero__btn {
  background: var(--gold);
  color: var(--navy);
  border: none;
  border-radius: 6px;
  padding: 10px 20px;
  font-size: 0.88rem;
  font-weight: 700;
  cursor: pointer;
  white-space: nowrap;
  transition: background 0.2s;
  font-family: var(--font);
}
.hero__btn:hover { background: var(--gold-light); }

@media (max-width: 600px) {
  .hero__search { flex-direction: column; align-items: stretch; }
  .hero__select { border-left: none; border-top: 1px solid var(--grey-300); }
}
</style>
