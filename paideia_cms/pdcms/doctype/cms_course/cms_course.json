{
  "actions": [],
  "autoname": "format:COURSE-{####}",
  "creation": "2026-01-01 00:00:00.000000",
  "doctype": "DocType",
  "engine": "InnoDB",
  "field_order": [
    "title",
    "slug",
    "institution",
    "template",
    "workflow_state",
    "cb1",
    "duration",
    "study_level",
    "instructor",
    "featured_image",
    "sb_content",
    "content_json",
    "sb_images",
    "image_slots_html",
    "image_overrides",
    "sb_seo",
    "meta_title",
    "meta_description",
    "og_image",
    "canonical_url",
    "sb_ai",
    "source_file",
    "ai_job",
    "generation_status",
    "ai_error_log"
  ],
  "fields": [
    {"fieldname": "title", "fieldtype": "Data", "label": "Title", "reqd": 1, "in_list_view": 1},
    {"fieldname": "slug", "fieldtype": "Data", "label": "Slug", "reqd": 1, "unique": 1, "in_list_view": 1},
    {
      "fieldname": "institution",
      "fieldtype": "Select",
      "label": "Institution",
      "options": "\nuws\npresidency",
      "in_list_view": 1,
      "description": "Used in frontend URL: /en/{institution}/{study_level}/{slug}"
    },
    {"fieldname": "template", "fieldtype": "Link", "label": "Template", "options": "CMS Template", "reqd": 1},
    {
      "fieldname": "workflow_state",
      "fieldtype": "Select",
      "label": "Workflow State",
      "options": "Draft\nReview\nApproved\nPublished\nArchived",
      "default": "Draft",
      "in_list_view": 1
    },
    {"fieldname": "cb1", "fieldtype": "Column Break"},
    {"fieldname": "duration", "fieldtype": "Data", "label": "Duration", "description": "e.g. 3 years, 1 year"},
    {
      "fieldname": "study_level",
      "fieldtype": "Select",
      "label": "Study Level",
      "options": "\nUndergraduate\nPostgraduate\nProfessional\nShort Course\nCertificate",
      "in_list_view": 1,
      "description": "Used in frontend URL: /en/{institution}/{study_level}/{slug}"
    },
    {"fieldname": "instructor", "fieldtype": "Data", "label": "Instructor"},
    {"fieldname": "featured_image", "fieldtype": "Attach Image", "label": "Featured Image"},
    {"fieldname": "sb_content", "fieldtype": "Section Break", "label": "Content"},
    {
      "fieldname": "content_json",
      "fieldtype": "Long Text",
      "label": "Content (JSON)",
      "description": "Canonical JSON: {hero, sections, seo, faq, cta}"
    },
    {"fieldname": "sb_images", "fieldtype": "Section Break", "label": "Images"},
    {"fieldname": "image_slots_html", "fieldtype": "HTML", "label": "Image Slots"},
    {
      "fieldname": "image_overrides",
      "fieldtype": "Long Text",
      "label": "Image Overrides (JSON)",
      "hidden": 1,
      "description": "Managed by the Images section above"
    },
    {"fieldname": "sb_seo", "fieldtype": "Section Break", "label": "SEO"},
    {"fieldname": "meta_title", "fieldtype": "Data", "label": "Meta Title"},
    {"fieldname": "meta_description", "fieldtype": "Small Text", "label": "Meta Description"},
    {"fieldname": "og_image", "fieldtype": "Attach Image", "label": "OG Image"},
    {"fieldname": "canonical_url", "fieldtype": "Data", "label": "Canonical URL"},
    {"fieldname": "sb_ai", "fieldtype": "Section Break", "label": "AI Generation", "collapsible": 1},
    {"fieldname": "source_file", "fieldtype": "Attach", "label": "Source Document", "description": "Upload PDF, DOCX, XLSX, or TXT to trigger AI generation"},
    {"fieldname": "ai_job", "fieldtype": "Link", "label": "AI Job", "options": "AI Job Log", "read_only": 1},
    {
      "fieldname": "generation_status",
      "fieldtype": "Select",
      "label": "Generation Status",
      "options": "Pending\nQueued\nExtracting\nGenerating\nCompleted\nFailed",
      "default": "Pending",
      "read_only": 1
    },
    {
      "fieldname": "ai_error_log",
      "fieldtype": "Code",
      "label": "AI Error Log",
      "read_only": 1,
      "depends_on": "eval:doc.generation_status=='Failed'"
    }
  ],
  "links": [],
  "modified": "2026-01-01 00:00:00.000000",
  "modified_by": "Administrator",
  "module": "PDCMS",
  "name": "CMS Course",
  "naming_rule": "Expression",
  "owner": "Administrator",
  "permissions": [
    {"create": 1, "delete": 1, "read": 1, "write": 1, "report": 1, "role": "CMS Admin"},
    {"create": 1, "read": 1, "write": 1, "role": "Content Editor"},
    {"read": 1, "write": 1, "role": "CMS Reviewer"},
    {"read": 1, "write": 1, "role": "CMS Publisher"}
  ],
  "sort_field": "modified",
  "sort_order": "DESC",
  "states": [
    {"color": "Yellow", "title": "Draft"},
    {"color": "Orange", "title": "Review"},
    {"color": "Blue", "title": "Approved"},
    {"color": "Green", "title": "Published"},
    {"color": "Gray", "title": "Archived"}
  ]
}
